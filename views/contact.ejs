<%- include('partials/head') %>
<div class="container narrow page">
  <h1>Get in touch</h1>
  <p class="lead">Questions about Helpie? We're here to help.</p>
  <form class="card pad" method="post" action="/contact">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="field"><label for="name">Full name</label><input id="name" name="name" type="text" required maxlength="100" autocomplete="name" value="<%= form.name || (currentUser ? currentUser.username : '') %>"></div>
      <div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" required autocomplete="email" value="<%= form.email || (currentUser ? currentUser.email : '') %>"></div>
    </div>
    <div class="field"><label for="subject">Subject</label><input id="subject" name="subject" type="text" required maxlength="150" value="<%= form.subject || '' %>"></div>
    <div class="field"><label for="message">Message</label><textarea id="message" name="message" required maxlength="5000" rows="6"><%= form.message || '' %></textarea></div>
    <button class="btn" type="submit">Send message</button>
  </form>
  <% if (settings.contact_email) { %><p class="muted small" style="margin-top:16px">Prefer email? Write to <a href="mailto:<%= settings.contact_email %>"><%= settings.contact_email %></a>.</p><% } %>
</div>
<%- include('partials/foot') %>
