<%- include('../partials/head') %>
<div class="container page stack">
  <%- include('../partials/admin-nav') %>
  <div class="tiles">
    <div class="card tile"><strong><%= stats.users %></strong><span>Members</span></div>
    <div class="card tile"><strong><%= stats.recentSignups %></strong><span>New this week</span></div>
    <div class="card tile"><strong><%= stats.activeUsers %></strong><span>Posting in last 30 days</span></div>
    <div class="card tile"><strong><%= stats.donations %></strong><span>Donations</span></div>
    <div class="card tile"><strong><%= stats.requests %></strong><span>Requests</span></div>
    <div class="card tile"><strong><%= stats.pendingReports %></strong><span><a href="/admin/reports">Open reports</a></span></div>
  </div>

  <% const max = Math.max(1, ...chart.map((c) => c.value)); %>
  <section class="card pad">
    <div class="section-title"><h2>New posts, last 14 days</h2><span class="muted small"><%= chart.reduce((sum, c) => sum + c.value, 0) %> total</span></div>
    <div class="bars" role="img" aria-label="Posts per day for the last 14 days">
      <% chart.forEach((c) => { %><div class="<%= c.value ? '' : 'zero' %>" style="height:<%= Math.round((c.value / max) * 100) %>%" title="<%= c.label %>: <%= c.value %>"></div><% }) %>
    </div>
    <div class="bars-axis"><span><%= chart[0].label %></span><span><%= chart[chart.length - 1].label %></span></div>
  </section>

  <div class="two-col">
    <section class="card pad">
      <div class="section-title"><h2>Latest posts</h2><a href="/admin/posts">View all</a></div>
      <% if (recentPosts.length) { %>
        <ul class="list">
          <% recentPosts.forEach((p) => { %>
            <li class="item">
              <div class="grow"><a href="/posts/<%= p.id %>"><strong><%= p.title %></strong></a><div class="muted small">by <a href="/users/<%= p.user_id %>"><%= p.username %></a> · <%= h.timeAgo(p.created_at) %></div></div>
              <span class="badge <%= p.type %>"><%= h.humanize(p.type) %></span>
            </li>
          <% }) %>
        </ul>
      <% } else { %><p class="muted">No posts yet.</p><% } %>
    </section>
    <section class="card pad">
      <h2>Contact form messages</h2>
      <% if (contactMessages.length) { %>
        <ul class="list">
          <% contactMessages.forEach((m) => { %>
            <li>
              <strong><%= m.subject %></strong>
              <div class="muted small"><%= m.name %> · <a href="mailto:<%= m.email %>"><%= m.email %></a> · <%= h.timeAgo(m.created_at) %></div>
              <p class="quote"><%= m.message %></p>
            </li>
          <% }) %>
        </ul>
      <% } else { %><p class="muted">No messages yet.</p><% } %>
    </section>
  </div>
</div>
<%- include('../partials/foot') %>
